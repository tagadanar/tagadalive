/**
 * EffectHandlers - Single source of truth for effect logic.
 *
 * These static methods contain all effect computation logic, used by both:
 * - Consequences handlers (combo building with simulated stats)
 * - SnapshotEffects handlers (initial pool with base stats)
 *
 * The context parameter is duck-typed: works with both Consequences and EffectSnapshot
 * since both implement the unified interface (add, addKill, isKilled, getHP, getHPMissing,
 * getExistingItemEffect, targets).
 *
 * Stats are passed explicitly to avoid branching inside handlers.
 * Non-stackable de-dupe is centralized here via dedupeIfNeeded().
 */
class EffectHandlers {

	/*
	 * Helper: Handle non-stackable effect de-duplication.
	 * If effect is non-stackable and target already has this effect, adds counter-effect.
	 * Returns true if de-dupe was applied.
	 */
	static boolean dedupeIfNeeded(ItemEffect effect, Entity target, integer stat, ctx) {
		if (effect.stackable) return false
		EffectOverTime? existing = ctx.getExistingItemEffectOfType(target, effect.item, effect.type)
		if (existing != null) {
			EffectOverTime counter = EffectOverTime(effect.item, -existing.value, existing.duration, effect.type)
			ctx.add(target, stat, counter)
			return true
		}
		return false
	}

	/*
	 * An effect whose caster was killed earlier in this chain is gone (generator Entity.die
	 * removes everything the dead cast). Free while the chain has no kill.
	 */
	static boolean isGone(EntityEffect ee, ctx) {
		if (!ctx.hasKills()) return false
		Entity? caster = Fight.getAllAlive()[ee.casterId]
		return caster != null && ctx.isKilled(caster!)
	}

	/*
	 * A death takes away what the dead cast, and its summons (generator Entity.die):
	 *  - its summons die with it, recursively, with no killer: kill value, no kill passives;
	 *  - each of its effects on a living entity is removed like liberation removes one (per-turn
	 *    value, net of what this chain already stripped of that type), for the turns it still
	 *    had to act (EntityEffect.left). The simulated stats change at once, so the rest of the
	 *    combo and the danger see the victim's allies without its buffs, us without its poisons.
	 * atTurnStart: a poison death at its own turn start. Whoever plays before it keeps one more
	 * turn (or tick) under the effect; an exposure effect keeps the part of the round before it.
	 * No effect-type bookkeeping: later handlers skip these effects through isGone(), so a
	 * liberation of another caster's effect of the same type is not under-counted.
	 * O(its summons + its effects), both indexed once per turn in Fight.indexEffects().
	 */
	static void onDeath(Entity dead, boolean atTurnStart, ctx) {
		Array<Entity>? summons = Fight.summonsOf[dead.id]
		if (summons != null) {
			for (Entity summon in summons!) ctx.addCascadeKill(summon, atTurnStart)
		}
		Array<EntityEffect>? cast = Fight.effectsByCaster[dead.id]
		if (cast == null) return;
		integer deadRank = Fight.rankOf(dead)
		for (EntityEffect ee in cast!) {
			Entity? t = Fight.getAllAlive()[ee.targetId]
			if (t == null || ctx.isKilled(t!)) continue
			if (ee.item == null) continue
			Entity target = t!
			boolean playsFirst = atTurnStart && Fight.rankOf(target) < deadRank
			integer lost = ee.left
			if (playsFirst || (atTurnStart && ee.family == EntityEffect.FAMILY_EXPOSURE)) lost--
			if (lost <= 0) continue
			integer? stat = Stats.entityEffectType_to_stats[ee.type]
			if (stat == null) continue
			integer remaining = ee.value - ctx.getEffectTypeAlteration(target, ee.type)
			if (remaining <= 0) continue
			integer value = remaining * TargetType.CONVERTER[ee.type]
			ctx.add(target, stat!, EffectOverTime(ee.item, -value, lost, ee.type))
			// Its next tick goes too (psnTurn counted it), unless that tick lands before the death
			if (ee.family == EntityEffect.FAMILY_TICK && !playsFirst) {
				if (ee.type == EFFECT_POISON) ctx.addPsnPerTurn(target, -remaining)
				else if (ee.type == EFFECT_HEAL) ctx.addPsnPerTurn(target, remaining)
			}
		}
	}

	/*
	 * The poison tick at the START of the target's NEXT turn kills it, before it acts.
	 * No antidote is in reach and no teammate heal lands before that tick: its own heals
	 * come after the tick, so only enemies that play before it count
	 * (BattleState.enemyHealBeforeTurn). A hemorrhage applied earlier in this chain
	 * denies exactly those heals, hence ctx.isUnhealable().
	 *
	 * This is the only poison death that happens BEFORE the target gets to act, so it is
	 * the only one that may count as "dead" (pools, danger, the overkill skip).
	 */
	static boolean poisonLethalNow(Entity target, ctx) {
		if (target.isFriend || target.nextAntidote < 1) return false
		integer left = ctx.getHP(target) - target.psnTurn - ctx.getPsnPerTurn(target)
		if (left > 0) return false
		// Heals only ever add HP, so they are all this branch has left to fear
		if (ctx.isUnhealable(target)) return true
		return left + (BattleState.enemyHealBeforeTurn[target] ?? 0.0) <= 0
	}

	/*
	 * The target survives the next tick but dies on the one after it: no antidote for two
	 * of its turns, the poisons still tick on the second one, and it cannot heal in
	 * between. Between the ticks it gets a FULL TURN - its own heals matter there, and our
	 * hemorrhage lasts only until our next turn, which covers that turn but not the
	 * teammate turns after it, so the teammate heal has to be zero on its own.
	 *
	 * It also gets to act in that turn, so this is worth score but never counts as dead.
	 */
	static boolean poisonLethalNext(Entity target, ctx) {
		if (target.isFriend || target.nextAntidote < 2) return false
		integer tick1 = target.psnTurn + ctx.getPsnPerTurn(target)
		// A target whose net per-turn poison is already <= 0 is not dying of poison
		if (tick1 <= 0) return false
		integer left = ctx.getHP(target) - tick1
		if (left <= 0) return false  // dies on the first tick: poisonLethalNow's business
		if ((BattleState.enemyHealBeforeTurn[target] ?? 0.0) > 0) return false
		if (!ctx.isUnhealable(target)) {
			real? ownHeal = BattleState.enemyOwnHealPotential[target]
			// null = map not built this turn: assume it can heal
			if (ownHeal == null || ownHeal! > 0) return false
		}
		integer tick2 = ctx.getPsnPerTurn2(target)
		for (EntityEffect entityEffect in target.effects) {
			// Ticks still to land (caster-driven expiry), minus effects of a caster killed in this chain
			if (entityEffect.left < 2 || EffectHandlers.isGone(entityEffect, ctx)) continue
			if (entityEffect.type == EFFECT_POISON) tick2 += entityEffect.value
			else if (entityEffect.type == EFFECT_HEAL) tick2 -= entityEffect.value
		}
		return tick2 > 0 && left - tick2 <= 0
	}

	/*
	 * Check if target will die from accumulated poison (guaranteed kill).
	 * Called after damage or poison application to award KILL_VALUE
	 * when the kill is certain (no antidote, no heal in time).
	 * A kill that only lands at the SECOND tick is scored but not marked dead.
	 */
	static void checkPoisonKill(Entity target, ctx) {
		if (target.isFriend || ctx.isKilled(target)) return;
		if (EffectHandlers.poisonLethalNow(target, ctx)) {
			ctx.addKill(target, true)  // dies at its own turn start
		} else if (EffectHandlers.poisonLethalNext(target, ctx)) {
			ctx.addPendingKill(target)
		}
	}

	// ════════════════════════════════════════════════════════════════════════
	// DAMAGE EFFECTS
	// ════════════════════════════════════════════════════════════════════════

	static void damage(ItemEffect effect, Entity source, Entity target, real ratio, integer srcStr, integer srcPwr, integer srcWsd, integer tgtRel, integer tgtAbs, integer tgtDmgRet, ctx) {
		integer targetsCount = effect.multiplyByTarget ? setSize(ctx.targets) : 1
		real beforeShield = EffectCalc.rawDamage(effect.avg, srcStr, srcPwr, ratio, targetsCount)
		real value = EffectCalc.applyShields(beforeShield, tgtRel, tgtAbs)
		integer damageDealt = round(value)

		// Track effect value for STEAL_LIFE chaining
		ctx.addEffectValue(damageDealt)

		// Track raw damage to enemies for Liberation combo detection
		if (!target.isFriend) {
			ctx.addRawEnemyDamage(beforeShield)
		}

		ctx.add(target, Stats.HP, -damageDealt)

		// Inline passives for damage taken (target's passives)
		Map<integer, real> passives = target.passives
		if (target.hasPassives && passives[EFFECT_DAMAGE_TO_STRENGTH]) {
			integer strGain = round(value * passives[EFFECT_DAMAGE_TO_STRENGTH]!)
			if (strGain > 0) ctx.add(target, Stats.STR, strGain)
		}
		if (target.hasPassives && passives[EFFECT_DAMAGE_TO_RESISTANCE]) {
			integer rstGain = round(value * passives[EFFECT_DAMAGE_TO_RESISTANCE]!)
			if (rstGain > 0) ctx.add(target, Stats.RST, rstGain)
		}
		if (target.hasPassives && passives[EFFECT_DAMAGE_TO_ABSOLUTE_SHIELD]) {
			integer shieldGain = round(value * passives[EFFECT_DAMAGE_TO_ABSOLUTE_SHIELD]!)
			if (shieldGain > 0) ctx.add(target, Stats.ABSSHIELD, shieldGain)
		}

		if (ctx.getHP(target) <= 0) {
			ctx.addKill(target)
		} else {
			EffectHandlers.checkPoisonKill(target, ctx)
		}

		// Erosion
		ctx.add(target, Stats.HPMAX, -EffectCalc.erosion(value))
		// Inline passive for nova/erosion
		if (target.hasPassives && passives[EFFECT_NOVA_DAMAGE_TO_MAGIC]) {
			integer magicGain = round(EffectCalc.erosion(value) * passives[EFFECT_NOVA_DAMAGE_TO_MAGIC]!)
			if (magicGain > 0) ctx.add(target, Stats.MGC, magicGain)
		}

		// Life steal (UNHEALABLE blocks vampirism, EffectDamage.java:52)
		if (!source.isUnhealable) {
			integer lifeSteal = EffectCalc.lifeSteal(value, srcWsd, ctx.getHPMissing(source))
			if (lifeSteal > 0) ctx.add(source, Stats.HP, lifeSteal)
		}

		// Damage return
		real dmgReturn = EffectCalc.damageReturn(beforeShield, tgtDmgRet)
		if (dmgReturn > 0) {
			ctx.add(source, Stats.HP, -round(dmgReturn))
			ctx.add(source, Stats.HPMAX, -EffectCalc.erosion(dmgReturn))
			if (dmgReturn >= ctx.getHP(source)) {
				ctx.addKill(source)
			}
		}
	}

	static void poison(ItemEffect effect, Entity source, Entity target, real ratio, integer srcMgc, integer srcPwr, boolean hasEffect, ctx) {
		// Check notReplaceable (e.g., COVID) - skip if target already has this effect
		if (effect.notReplaceable && hasEffect) return;

		// Cap duration by enemy antidote availability (min 1: force antidote use + cooldown)
		integer duration = effect.duration
		if (!target.isFriend && target.nextAntidote < duration) {
			duration = max(1, target.nextAntidote)
		}
		if (duration <= 0) return;

		integer value = EffectCalc.poisonDamage(effect.avg, srcMgc, srcPwr, ratio, duration)
		EffectOverTime eot = EffectOverTime(effect.item, -value, duration, effect.type)
		ctx.add(target, Stats.HPTIME, eot)

		// Track per-turn poison for overkill detection
		integer perTurn = round(effect.avg * (1 + srcMgc / 100.0) * ratio * (1 + srcPwr / 100.0))
		ctx.addPsnPerTurn(target, perTurn)
		// Only a poison that outlives the target's next turn still ticks a second time
		if (duration >= 2) ctx.addPsnPerTurn2(target, perTurn)
		EffectHandlers.checkPoisonKill(target, ctx)

		// Inline passive for poison taken (target's passives)
		Map<integer, real> passives = target.passives
		if (target.hasPassives && passives[EFFECT_POISON_TO_SCIENCE]) {
			integer sciGain = round(effect.avg * passives[EFFECT_POISON_TO_SCIENCE]!)
			if (sciGain > 0) ctx.add(target, Stats.SNC, sciGain)
		}

		// Erosion (only 1 turn - often antidoted/liberated)
		integer erosion = EffectCalc.poisonErosion(value, duration)
		ctx.add(target, Stats.HPMAX, -erosion)
		// Inline passive for nova/erosion
		if (target.hasPassives && passives[EFFECT_NOVA_DAMAGE_TO_MAGIC]) {
			integer magicGain = round(erosion * passives[EFFECT_NOVA_DAMAGE_TO_MAGIC]!)
			if (magicGain > 0) ctx.add(target, Stats.MGC, magicGain)
		}
	}

	/*
	 * Superinfection (generator 3c04831, 2026-09-16): the poisons on the target DETONATE.
	 * The target takes, once, ratio x the sum of their current per-turn values (no
	 * remaining-turns factor), and every finite poison loses ONE turn: one on its last turn
	 * disappears, the others keep ticking with their value intact. Poison damage: poison
	 * erosion, no lifesteal, no damage return. The price is one tick of each poison whatever
	 * the moment, so that lost tick is charged here.
	 *
	 * comboPoisons = poison EffectOverTime added by earlier actions of this combo, already
	 * scored as HPTIME (their value is the antidote-capped total, negative); the combo's
	 * per-turn poison is ctx.getPsnPerTurn(target). Turn-start poisons come from
	 * target.effects (per-turn value, remaining turns) and were never scored.
	 */
	static void superinfection(ItemEffect effect, Entity source, Entity target, real ratio, Array<EffectOverTime> comboPoisons, ctx) {
		integer perTurnStart = 0
		integer perTurnStartLast = 0  // turn-start poisons on their last turn: they vanish
		integer perTurnStartTwo = 0   // turn-start poisons with exactly 2 turns: they lose the 2nd tick
		for (EntityEffect entityEffect in target.effects) {
			// Every poison still ON the target detonates, even one its caster removes before
			// the next tick; one of a caster killed earlier in this chain is gone already
			if (entityEffect.type != EFFECT_POISON || entityEffect.turns <= 0) continue
			if (EffectHandlers.isGone(entityEffect, ctx)) continue
			perTurnStart += entityEffect.value
			// Losing a turn loses a tick: left (ticks still to land) goes down by one
			if (entityEffect.left == 1) perTurnStartLast += entityEffect.value
			else if (entityEffect.left == 2) perTurnStartTwo += entityEffect.value
		}
		integer perTurnCombo = ctx.getPsnPerTurn(target)
		integer perTurn = perTurnStart + perTurnCombo
		if (perTurn <= 0) return;

		real convRatio = min(1.0, effect.avg / 100.0)
		integer damage = min(round(convRatio * perTurn), ctx.getHP(target))
		if (damage <= 0) return;

		ctx.addEffectValue(damage)
		ctx.add(target, Stats.HP, -damage)
		boolean killed = ctx.getHP(target) <= 0
		if (killed) ctx.addKill(target)

		// Erosion (poison erosion, on the whole immediate hit)
		integer erosion = round(damage / Stats.PSN_EROSION_DIVISOR)
		ctx.add(target, Stats.HPMAX, -erosion)
		// Inline passive for nova/erosion (target's passives)
		Map<integer, real> passives = target.passives
		if (target.hasPassives && passives[EFFECT_NOVA_DAMAGE_TO_MAGIC]) {
			integer magicGain = round(erosion * passives[EFFECT_NOVA_DAMAGE_TO_MAGIC]!)
			if (magicGain > 0) ctx.add(target, Stats.MGC, magicGain)
		}

		// Every poison lost a turn: the next tick keeps only those that had 2 turns or more
		// (psnPerTurn2 for this combo's), the tick after only those that had 3 or more.
		integer comboTwo = 0  // this combo's poisons of exactly 2 turns, per tick
		for (EffectOverTime eot in comboPoisons) {
			if (eot.value < 0 && eot.duration == 2) comboTwo += round(-eot.value / 2.0)
		}
		ctx.addPsnPerTurn(target, -perTurnStartLast - (perTurnCombo - ctx.getPsnPerTurn2(target)))
		ctx.addPsnPerTurn2(target, -perTurnStartTwo - comboTwo)
		if (killed) return;
		// The poisons that remain may still finish a target the hit left low
		EffectHandlers.checkPoisonKill(target, ctx)

		// On a survivor, charge the lost tick through the same mitigated-duration path as any
		// poison: remove the scored total, put back the total one turn shorter. A tick past
		// the target's next antidote was never scored and costs nothing.
		for (EffectOverTime eot in comboPoisons) {
			if (eot.value >= 0) continue
			integer realTurns = eot.duration
			for (ItemEffect itemEffect in eot.item.effects) {
				if (itemEffect.type == EFFECT_POISON) { realTurns = itemEffect.duration; break }
			}
			if (realTurns - 1 >= eot.duration) continue
			integer d = eot.duration
			ctx.add(target, Stats.HPTIME, EffectOverTime(eot.item, -eot.value, d, EFFECT_POISON))
			if (d >= 2) ctx.add(target, Stats.HPTIME, EffectOverTime(eot.item, round(eot.value * (d - 1) / d), d - 1, EFFECT_POISON))
		}
		for (EntityEffect entityEffect in target.effects) {
			if (entityEffect.type != EFFECT_POISON || entityEffect.left <= 0) continue
			if (EffectHandlers.isGone(entityEffect, ctx)) continue
			integer turns = entityEffect.left
			if (!target.isFriend && target.nextAntidote < turns) turns = max(1, target.nextAntidote)
			if (entityEffect.left - 1 >= turns) continue
			ctx.add(target, Stats.HPTIME, EffectOverTime(effect.item, entityEffect.value * turns, turns, EFFECT_POISON))
			if (turns >= 2) ctx.add(target, Stats.HPTIME, EffectOverTime(effect.item, -entityEffect.value * (turns - 1), turns - 1, EFFECT_POISON))
		}
	}

	static void lifeDamage(ItemEffect effect, Entity source, Entity target, real ratio, integer srcLife, integer srcPwr, integer tgtRel, integer tgtAbs, integer tgtDmgRet, ctx) {
		real beforeShield = EffectCalc.lifeDamageRaw(srcLife, effect.avg, srcPwr)
		real value = EffectCalc.applyShields(beforeShield, tgtRel, tgtAbs)

		// Track raw damage to enemies for Liberation combo detection
		if (!target.isFriend) {
			ctx.addRawEnemyDamage(beforeShield)
		}

		ctx.add(target, Stats.HP, -round(value))

		if (ctx.getHP(target) <= 0) {
			ctx.addKill(target)
		} else {
			EffectHandlers.checkPoisonKill(target, ctx)
		}

		// Erosion
		ctx.add(target, Stats.HPMAX, -EffectCalc.erosion(value))
		// Inline passive for nova/erosion (target's passives)
		Map<integer, real> passives = target.passives
		if (target.hasPassives && passives[EFFECT_NOVA_DAMAGE_TO_MAGIC]) {
			integer magicGain = round(EffectCalc.erosion(value) * passives[EFFECT_NOVA_DAMAGE_TO_MAGIC]!)
			if (magicGain > 0) ctx.add(target, Stats.MGC, magicGain)
		}

		if (target != source) {
			// Damage return
			real dmgReturn = EffectCalc.damageReturn(beforeShield, tgtDmgRet)
			if (dmgReturn > 0) {
				ctx.add(source, Stats.HP, -round(dmgReturn))
				ctx.add(source, Stats.HPMAX, -EffectCalc.erosion(dmgReturn))
				if (dmgReturn >= ctx.getHP(source)) {
					ctx.addKill(source)
				}
			}
		}
	}

	static void novaDamage(ItemEffect effect, Entity source, Entity target, real ratio, integer srcSnc, integer srcPwr, integer tgtHPMiss, ctx) {
		integer value = EffectCalc.novaDamage(effect.avg, srcSnc, srcPwr, ratio, tgtHPMiss)

		// Track effect value for STEAL_LIFE chaining
		ctx.addEffectValue(value)

		ctx.add(target, Stats.HPMAX, -value)

		// Inline passive for nova (target's passives)
		Map<integer, real> passives = target.passives
		if (target.hasPassives && passives[EFFECT_NOVA_DAMAGE_TO_MAGIC]) {
			integer magicGain = round(value * passives[EFFECT_NOVA_DAMAGE_TO_MAGIC]!)
			if (magicGain > 0) ctx.add(target, Stats.MGC, magicGain)
		}
	}

	static void aftereffect(ItemEffect effect, Entity source, Entity target, real ratio, integer srcSnc, ctx) {
		integer value = EffectCalc.aftereffectDamage(effect.avg, srcSnc, ratio)
		EffectOverTime eot = EffectOverTime(effect.item, -value, effect.duration, effect.type)
		ctx.add(target, Stats.HP, -value)
		ctx.add(target, Stats.HPTIME, eot)

		if (ctx.getHP(target) <= 0) {
			ctx.addKill(target)
		}

		// Erosion
		ctx.add(target, Stats.HPMAX, -EffectCalc.erosion(value))
		// Inline passive for nova/erosion (target's passives)
		Map<integer, real> passives = target.passives
		if (target.hasPassives && passives[EFFECT_NOVA_DAMAGE_TO_MAGIC]) {
			integer magicGain = round(EffectCalc.erosion(value) * passives[EFFECT_NOVA_DAMAGE_TO_MAGIC]!)
			if (magicGain > 0) ctx.add(target, Stats.MGC, magicGain)
		}
	}

	// ════════════════════════════════════════════════════════════════════════
	// HEAL EFFECTS
	// ════════════════════════════════════════════════════════════════════════

	static void heal(ItemEffect effect, Entity source, Entity target, real ratio, integer srcWsd, integer tgtHPMiss, ctx) {
		integer targetsCount = effect.multiplyByTarget ? setSize(ctx.targets) : 1
		if (effect.duration > 1) {
			// Heal over time - de-dupe if non-stackable
			EffectHandlers.dedupeIfNeeded(effect, target, Stats.HPTIME, ctx)
			integer value = EffectCalc.healValue(effect.avg, srcWsd, ratio) * targetsCount
			EffectOverTime eot = EffectOverTime(effect.item, value, effect.duration, effect.type)
			ctx.add(target, Stats.HPTIME, eot)
		} else {
			// Instant heal - no de-dupe needed
			// UNHEALABLE gains no HP (EffectHeal.java:18). Only the instant part is
			// blocked: the state lasts one turn, later HoT ticks land normally.
			if (target.isUnhealable) return;
			integer value = EffectCalc.healCapped(effect.avg, srcWsd, ratio, tgtHPMiss) * targetsCount
			if (value > 0) ctx.add(target, Stats.HP, value)
		}
	}

	static void boostMaxLife(ItemEffect effect, Entity source, Entity target, real ratio, integer srcWsd, ctx) {
		integer value = EffectCalc.boostMaxLife(effect.avg, srcWsd, ratio)
		ctx.add(target, Stats.HPMAX, value)
		// UNHEALABLE still grows the gauge, it just no longer fills it (EffectVitality.java:29)
		if (target.isUnhealable) return;
		ctx.add(target, Stats.HP, value)
	}

	static void novaVitality(ItemEffect effect, Entity source, Entity target, real ratio, integer srcSnc, ctx) {
		integer value = EffectCalc.novaVitality(effect.avg, srcSnc, ratio)
		ctx.add(target, Stats.HPMAX, value)
	}

	static void rawHeal(ItemEffect effect, Entity source, Entity target, real ratio, integer tgtHPMiss, ctx) {
		// UNHEALABLE gains no HP (EffectRawHeal.java:12)
		if (target.isUnhealable) return;
		integer value = EffectCalc.rawHealCapped(effect.avg, ratio, tgtHPMiss)
		if (value > 0) ctx.add(target, Stats.HP, value)
	}

	/*
	 * Value of making an enemy UNHEALABLE (CHIP_HEMORRHAGE): the heal its team could
	 * still pour into it, bounded by what it could actually heal BACK - its missing HP,
	 * the poison tick it is guaranteed to take before it plays, and the damage our
	 * allies will land on it before it plays. Healing past full life is worth nothing.
	 *
	 * @param target        The entity the state is applied on
	 * @param allyDmgBefore MapDamage.getDamageBeforeEnemy on the target's cell
	 * @param selfDmgBefore Damage WE still land before it plays. The snapshot passes
	 *                      BattleState.selfDamagePotential (an estimate: no combo exists
	 *                      yet, and a 0 gap would get the action filtered out of the pool);
	 *                      the combo path passes 0, because at priority 26 the damage
	 *                      already dealt is inside ctx.getHPMissing(target).
	 */
	static real unhealableValue(Entity target, real allyDmgBefore, real selfDmgBefore, ctx) {
		if (target.isFriend) return 0.0
		// Never stacks (the generator replaces rather than merges ADD_STATE)
		if (target.isUnhealable) return 0.0
		real? potential = BattleState.enemyHealPotential[target]
		if (potential == null || potential <= 0) return 0.0

		real gap = ctx.getHPMissing(target) + allyDmgBefore + selfDmgBefore
		// nextAntidote 0 means an enemy cures it before the tick lands
		if (target.nextAntidote >= 1) gap += target.psnTurn
		if (gap <= 0) return 0.0

		real denied = min(potential!, gap)
		// HP coef is negative on enemies (damage scores -dmg * coef), so a denied heal
		// is worth the same as that much damage.
		return denied * (-Scoring.getDynamicCoef(target, Stats.HP, null))
	}

