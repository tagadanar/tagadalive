include('../includesTests')

// Own-turn effects expire at the CASTER's turn start, ticks at each hit on the TARGET
// (generator Entity.startTurn): ranks are the order of the next turn starts from now,
// the playing entity last.

function testOwnTurns() {
	assertEquals("EffectTimingTests::ownTurnsCasterStartsFirst", 0, EntityEffect.ownTurns(1, 0, 2))
	assertEquals("EffectTimingTests::ownTurnsCasterStartsAfter", 1, EntityEffect.ownTurns(1, 3, 1))
	assertEquals("EffectTimingTests::ownTurnsSelfCast", 1, EntityEffect.ownTurns(2, 4, 4))
}

// A poison on self from a caster that starts first still lands its last tick
function testTicks() {
	Array<Entity> order = Fight.getEntitiesAfterSelfInOrder()
	if (count(order) == 0 || count(Fight.self.items) == 0) return;
	EntityEffect poison = EntityEffect([EFFECT_POISON, 10, order[0].id, 1, false, Fight.self.items[0].id, Fight.self.id, 0])
	assertEquals("EffectTimingTests::ticksCasterStartsFirst", 1, poison.left)
}

function testFamilies() {
	assertEquals("EffectTimingTests::familyPoison", EntityEffect.FAMILY_TICK, EntityEffect.familyOf(EFFECT_POISON))
	assertEquals("EffectTimingTests::familyAftereffect", EntityEffect.FAMILY_TICK, EntityEffect.familyOf(EFFECT_AFTEREFFECT))
	assertEquals("EffectTimingTests::familyHeal", EntityEffect.FAMILY_TICK, EntityEffect.familyOf(EFFECT_HEAL))
	assertEquals("EffectTimingTests::familyBuffMP", EntityEffect.FAMILY_OWN, EntityEffect.familyOf(EFFECT_BUFF_MP))
	assertEquals("EffectTimingTests::familyShackleTP", EntityEffect.FAMILY_OWN, EntityEffect.familyOf(EFFECT_SHACKLE_TP))
	assertEquals("EffectTimingTests::familyShield", EntityEffect.FAMILY_EXPOSURE, EntityEffect.familyOf(EFFECT_ABSOLUTE_SHIELD))
	assertEquals("EffectTimingTests::familyVulnerability", EntityEffect.FAMILY_EXPOSURE, EntityEffect.familyOf(EFFECT_VULNERABILITY))
}

function testRanks() {
	integer n = mapSize(Fight.getAllAlive())
	assertEquals("EffectTimingTests::rankSelfLast", n - 1, Fight.rankOf(Fight.self))
	Map<integer, boolean> seen = [:]
	boolean distinct = true
	for (integer id : Entity e in Fight.getAllAlive()) {
		integer? r = Fight.nextStartRank[id]
		if (r == null || seen[r!]) distinct = false
		else seen[r!] = true
	}
	assertEquals("EffectTimingTests::ranksDistinctForAll", true, distinct)
	Array<Entity> order = Fight.getEntitiesAfterSelfInOrder()
	if (count(order) > 0) assertEquals("EffectTimingTests::rankFirstAfterSelf", 0, Fight.rankOf(order[0]))
}

function checkEffectTiming() {
	testOwnTurns()
	testTicks()
	testFamilies()
	testRanks()
}
